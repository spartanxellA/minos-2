# Copia a .env y llena lo que tengas. Nada de esto se sube al repositorio.
POSTGRES_PASSWORD=cambia-esto
DEMO_ENABLED=true

# Fuera de development la API exige un emisor OIDC (Keycloak, Entra ID, Auth0...)
MINOS_ENV=development
AUTH_AUTHORITY=

# Conectores (vacío = conector apagado)
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
# Bluesky en tiempo real (Jetstream): no necesita cuenta
BLUESKY_LIVE=false
# App de https://www.reddit.com/prefs/apps; el User-Agent debe identificar la app y su responsable
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=minOS/2.0 (by u/tu_cuenta)
# Token de Meta (usuario del sistema) para comentarios en páginas propias de Facebook e Instagram
META_ACCESS_TOKEN=

# Avisos de alertas (vacío = apagado). Las listas van en JSON: ["a@ejemplo.com","b@ejemplo.com"]
DASHBOARD_URL=http://localhost:3000
ALERT_EMAIL_HOST=
ALERT_EMAIL_PORT=587
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=[]
# Slack, Teams o un sistema propio
ALERT_WEBHOOK_URLS=[]
ALERT_WEBHOOK_SECRET=
# WhatsApp Cloud API (plantilla aprobada "minos_alerta"); números con lada, sin "+"
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=[]

# Análisis profundo con Claude (solo menciones negativas o de alto alcance)
MINOS_CLAUDE_ENABLED=0
ANTHROPIC_API_KEY=
