# Copia a .env y llena lo que tengas. Nada de esto se sube al repositorio.
# En el servidor genera la clave con: openssl rand -hex 24
POSTGRES_PASSWORD=cambia-esto

# Solo en el servidor (docker-compose.prod.yml): dominio ya apuntado a la IP del servidor y correo para Let's Encrypt
DOMAIN=
ACME_EMAIL=
DEMO_ENABLED=true

MINOS_ENV=development
# Inicio de sesión: "local" (cuentas de minOS) u "off" (sin contraseña, solo en development)
AUTH_MODE=local
# Primer administrador: se crea al arrancar si no hay cuentas. Después puedes borrar estas dos líneas.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Tiempo sin actividad antes de cerrar la sesión, en segundos (1800 = 30 min; 0 = nunca).
IDLE_TIMEOUT_SECONDS=1800

# Conectores (vacío = conector apagado)
# Feeds RSS de medios, además de Google Noticias. Lista en JSON: ["https://medio.com/rss","https://otro.com/feed"]
RSS_FEEDS=[]
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
# Cuota diaria de la API (10000 gratis). Cada búsqueda gasta ~101; con muchos objetivos el intervalo se alarga solo.
# YOUTUBE_POLL_INTERVAL es el mínimo en segundos entre consultas de un mismo objetivo.
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_POLL_INTERVAL=1800
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
# Bluesky en tiempo real (Jetstream): no necesita cuenta
BLUESKY_LIVE=false
# App de https://www.reddit.com/prefs/apps; el User-Agent debe identificar la app y su responsable
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=minOS/2.0 (by u/tu_cuenta)
# Token de Meta (usuario del sistema) para comentarios en páginas propias de Facebook e Instagram
META_ACCESS_TOKEN=

# Listas negras (OFAC, ONU, UE, Reino Unido, SAT 69-B): se descargan solas. Las listas propias (PEP) se suben desde
# el tablero. El Banco Mundial pide una llave para su API; sin ella esa lista no se descarga.
WATCHLISTS_ENABLED=true
WORLDBANK_API_KEY=

# Avisos de alertas (vacío = apagado). Las listas van en JSON: ["a@ejemplo.com","b@ejemplo.com"]
DASHBOARD_URL=http://localhost:3000
ALERT_EMAIL_HOST=
ALERT_EMAIL_PORT=587
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=[]
# Slack, Teams o un sistema propio
ALERT_WEBHOOK_URLS=[]
ALERT_WEBHOOK_SECRET=
# WhatsApp Cloud API (plantilla aprobada "minos_alerta"); números con lada, sin "+"
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=[]

# Análisis profundo con Claude (solo menciones negativas, dudosas o de alto alcance; entiende ironía)
# Con Haiku 5.5 cuesta centavos de dólar por cada mil menciones revisadas.
MINOS_CLAUDE_ENABLED=0
MINOS_CLAUDE_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# Respaldos (deploy/backup.sh). Copia externa cifrada: sin esto los respaldos solo quedan en el servidor.
# DigitalOcean Spaces: crea un Space privado y una llave de acceso (Spaces Keys) solo para ese Space.
BACKUP_S3_ENDPOINT=nyc3.digitaloceanspaces.com
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Otro proveedor S3 (Backblaze B2, AWS, Wasabi): cambia el endpoint y pon BACKUP_S3_PROVIDER=Other (o AWS, Wasabi).
# BACKUP_S3_PROVIDER=DigitalOcean
# BACKUP_S3_REGION=
# BACKUP_S3_PREFIX=minos
# Frase para cifrar la copia externa. Guárdala también FUERA del servidor (gestor de contraseñas): sin ella los
# respaldos externos no se pueden abrir. Genérala con: openssl rand -base64 32
BACKUP_PASSPHRASE=
# Aviso si un respaldo falla o no llega (por ejemplo https://hc-ping.com/<id> de healthchecks.io, gratis)
BACKUP_PING_URL=
# Días que se guardan: en el servidor, diarios en la copia externa y meses de la copia mensual (día 1)
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE_KEEP_DAYS=30
BACKUP_REMOTE_KEEP_MONTHS=12
